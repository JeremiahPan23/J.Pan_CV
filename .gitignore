# Ignore any temporary files
*.tmp
*.temp

# Ignore log files
*.log

# Ignore node_modules if using npm
node_modules/

# Ignore IDE-specific files
.idea/
.vscode/
*.swp
*.swo
*~

# Ignore OS-specific files
.DS_Store
Thumbs.db

# Local rendering artifacts; keep final CV sources and PDFs tracked.
tmp/
__pycache__/
*.aux
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz
